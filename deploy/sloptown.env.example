# /etc/sloptown/sloptown.env — read by the sloptown-* quadlet units.
# Copy, fill in every CHANGE_ME, chmod 600, owned by the sloptown user.
# Generate secrets with: openssl rand -hex 32

# --- Public names --------------------------------------------------------------
# Studio and apps sit under Miira's own site (same registrable domain as Miira's
# drive), so the browser treats the app inside Miira as first-party: Safari keeps its
# login cookie. Precondition: Miira's session cookie is NOT scoped to a parent of
# these names (it must be .hej.miira.dk, never .miira.dk). See docs/miira-integration.md.
SLOPTOWN_STUDIO_ORIGIN=https://studio.apps.miira.dk
SLOPTOWN_APPS_DOMAIN=apps.miira.dk
SLOPTOWN_APPS_SCHEME=https
SLOPTOWN_APPS_PORT=
SLOPTOWN_MIIRA_ORIGINS=["https://hej.miira.dk"]
# After a domain move: the old names, redirected by the edge (LEGACY_MODE below).
SLOPTOWN_LEGACY_APPS_DOMAINS=[]
SLOPTOWN_LEGACY_STUDIO_HOSTS=[]
SLOPTOWN_DEV_MODE=false

# --- Database ------------------------------------------------------------------
POSTGRES_USER=sloptown
POSTGRES_DB=sloptown
POSTGRES_PASSWORD=CHANGE_ME
SLOPTOWN_DATABASE_URL=postgresql+asyncpg://sloptown:CHANGE_ME@sloptown-db:5432/sloptown

# --- Miira ---------------------------------------------------------------------
SLOPTOWN_MIIRA_ISSUER=https://miira.dk
SLOPTOWN_MIIRA_API_BASE=https://miira.dk
SLOPTOWN_OIDC_CLIENT_ID=sloptown
SLOPTOWN_OIDC_CLIENT_SECRET=CHANGE_ME
SLOPTOWN_MIIRA_WEBHOOK_SECRET=CHANGE_ME

# --- Internal secrets ----------------------------------------------------------
SLOPTOWN_SESSION_SECRET=CHANGE_ME
SLOPTOWN_INTERNAL_SECRET=CHANGE_ME
SLOPTOWN_EDGE_SECRET=CHANGE_ME

# --- Podman (rootless socket of the sloptown user, mounted into sloptown-cp) ----
SLOPTOWN_PODMAN_URL=unix:///run/podman/podman.sock
SLOPTOWN_DEV_IMAGE=localhost:5000/sloptown/vibe-dev:latest
SLOPTOWN_RUNTIME_IMAGE=localhost:5000/sloptown/vibe-runtime:latest
SLOPTOWN_OCI_RUNTIME=runsc
SLOPTOWN_POOL_SIZE=5

# --- Inference -----------------------------------------------------------------
SLOPTOWN_OPENAI_API_KEY=CHANGE_ME
SLOPTOWN_CONTROL_PLANE_URL=http://sloptown-cp:8000
SLOPTOWN_EGRESS_ENV_FILE=/etc/sloptown/egress.env

# --- Budget notifications (mail to the watchers set in Miira's admin) ----------
# Empty host: notices are only logged by sloptown-egress.
SLOPTOWN_SMTP_HOST=
SLOPTOWN_SMTP_PORT=587
SLOPTOWN_SMTP_USER=
SLOPTOWN_SMTP_PASSWORD=
SLOPTOWN_SMTP_FROM=SlopTown <noreply@sloptown.dk>

# --- Edge (Caddy) --------------------------------------------------------------
STUDIO_HOST=studio.apps.miira.dk
APPS_DOMAIN=apps.miira.dk
STUDIO_ORIGIN=https://studio.apps.miira.dk
MIIRA_ORIGINS=https://hej.miira.dk
# Miira's session cookie name; the edge strips it before requests reach a Vibe.
MIIRA_SESSION_COOKIE=miira_session
CP_UPSTREAM=sloptown-cp:8000
# Miira's backend egress IPs (space separated CIDRs).
ADMIN_ALLOWED_IPS=CHANGE_ME/32
ACME_EMAIL=CHANGE_ME
# acme: one Let's Encrypt certificate per app host (50 new per week per domain).
# file: one wildcard certificate for *.APPS_DOMAIN from /etc/sloptown/tls
#       (fullchain.pem = certificate then chain, priv.pem = key, readable by the
#       service user, mode 600). Renew by replacing both and restarting sloptown-edge.
TLS_MODE=acme
# on: 307 the old names to the new ones (edge/legacy-on.caddy), e.g. for the
# 2026-11 move: LEGACY_STUDIO_HOST=studio.miira-apps.dk, LEGACY_APPS_DOMAIN=miira-apps.dk
# (and the same in SLOPTOWN_LEGACY_* above, so their certificates keep renewing).
LEGACY_MODE=off
LEGACY_STUDIO_HOST=
LEGACY_APPS_DOMAIN=
