# /etc/sloptown/sloptown.env — read by the sloptown-* quadlet units.
# Copy, fill in every CHANGE_ME, chmod 600, owned by the sloptown user.
# Generate secrets with: openssl rand -hex 32

# --- Public names --------------------------------------------------------------
SLOPTOWN_STUDIO_ORIGIN=https://studio.sloptown.dk
SLOPTOWN_APPS_DOMAIN=miira-apps.dk
SLOPTOWN_APPS_SCHEME=https
SLOPTOWN_APPS_PORT=
SLOPTOWN_MIIRA_ORIGINS=["https://miira.dk"]
SLOPTOWN_DEV_MODE=false

# --- Database ------------------------------------------------------------------
POSTGRES_USER=sloptown
POSTGRES_DB=sloptown
POSTGRES_PASSWORD=CHANGE_ME
SLOPTOWN_DATABASE_URL=postgresql+asyncpg://sloptown:CHANGE_ME@sloptown-db:5432/sloptown

# --- Miira ---------------------------------------------------------------------
SLOPTOWN_MIIRA_ISSUER=https://miira.dk
SLOPTOWN_MIIRA_API_BASE=https://miira.dk
SLOPTOWN_OIDC_CLIENT_ID=sloptown
SLOPTOWN_OIDC_CLIENT_SECRET=CHANGE_ME
SLOPTOWN_MIIRA_WEBHOOK_SECRET=CHANGE_ME

# --- Internal secrets ----------------------------------------------------------
SLOPTOWN_SESSION_SECRET=CHANGE_ME
SLOPTOWN_INTERNAL_SECRET=CHANGE_ME
SLOPTOWN_EDGE_SECRET=CHANGE_ME

# --- Podman (rootless socket of the sloptown user, mounted into sloptown-cp) ----
SLOPTOWN_PODMAN_URL=unix:///run/podman/podman.sock
SLOPTOWN_DEV_IMAGE=localhost:5000/sloptown/vibe-dev:latest
SLOPTOWN_RUNTIME_IMAGE=localhost:5000/sloptown/vibe-runtime:latest
SLOPTOWN_OCI_RUNTIME=runsc
SLOPTOWN_POOL_SIZE=5

# --- Inference -----------------------------------------------------------------
SLOPTOWN_OPENAI_API_KEY=CHANGE_ME
SLOPTOWN_CONTROL_PLANE_URL=http://sloptown-cp:8000
SLOPTOWN_EGRESS_ENV_FILE=/etc/sloptown/egress.env

# --- Budget notifications (mail to the watchers set in Miira's admin) ----------
# Empty host: notices are only logged by sloptown-egress.
SLOPTOWN_SMTP_HOST=
SLOPTOWN_SMTP_PORT=587
SLOPTOWN_SMTP_USER=
SLOPTOWN_SMTP_PASSWORD=
SLOPTOWN_SMTP_FROM=SlopTown <noreply@sloptown.dk>

# --- Edge (Caddy) --------------------------------------------------------------
STUDIO_HOST=studio.sloptown.dk
APPS_DOMAIN=miira-apps.dk
STUDIO_ORIGIN=https://studio.sloptown.dk
MIIRA_ORIGINS=https://miira.dk
CP_UPSTREAM=sloptown-cp:8000
# Miira's backend egress IPs (space separated CIDRs).
ADMIN_ALLOWED_IPS=CHANGE_ME/32
ACME_EMAIL=CHANGE_ME
