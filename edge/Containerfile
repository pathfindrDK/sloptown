# sloptown-edge: Caddy with caddy-ratelimit, the studio SPA and the Caddyfiles.
# Build context: repo root. STUDIO_IMAGE is built from deploy/containers/studio.Containerfile.
ARG CADDY_BUILDER=docker.io/library/caddy:2.11-builder-alpine
ARG CADDY_IMAGE=docker.io/library/caddy:2.11-alpine
ARG STUDIO_IMAGE=localhost/sloptown/studio:latest

FROM ${STUDIO_IMAGE} AS studio

FROM ${CADDY_BUILDER} AS build
ARG RATELIMIT_VERSION=v0.1.0
ARG CADDY_VERSION=v2.11.7
RUN xcaddy build ${CADDY_VERSION} --with github.com/mholt/caddy-ratelimit@${RATELIMIT_VERSION}

FROM ${CADDY_IMAGE}
RUN apk upgrade --no-cache
COPY --from=build /usr/bin/caddy /usr/bin/caddy
COPY --from=studio /srv/studio /srv/studio
COPY edge/Caddyfile edge/Caddyfile.dev edge/Caddyfile.public edge/common.caddy edge/gate-on.caddy edge/gate-off.caddy /etc/caddy/
ENV CP_UPSTREAM=sloptown-cp:8000 FAKE_MIIRA_UPSTREAM=sloptown-fake-miira:8100 \
    ADMIN_ALLOWED_IPS=127.0.0.1/32 MIIRA_ORIGINS=https://miira.dk
LABEL io.containers.autoupdate=registry
