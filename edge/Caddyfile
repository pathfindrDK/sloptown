# Production edge. Env (see deploy/quadlet/sloptown-edge.container):
#   STUDIO_HOST, APPS_DOMAIN, STUDIO_ORIGIN, MIIRA_ORIGINS, CP_UPSTREAM,
#   ADMIN_ALLOWED_IPS, ACME_EMAIL
{
	email {$ACME_EMAIL}
	order rate_limit before basic_auth
	# Per-app certificates, issued only for slugs the control plane knows.
	# Switch to a DNS-01 wildcard for *.APPS once the DNS provider is chosen
	# (needs a caddy-dns plugin in edge/Containerfile).
	on_demand_tls {
		ask http://{$CP_UPSTREAM}/edge/tls-ask
	}
}

import /etc/caddy/common.caddy

{$STUDIO_HOST} {
	import studio
}

*.{$APPS_DOMAIN} {
	tls {
		on_demand
	}
	import apps
}
