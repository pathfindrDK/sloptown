# Production edge. Env (see deploy/quadlet/sloptown-edge.container):
#   STUDIO_HOST, APPS_DOMAIN, STUDIO_ORIGIN, MIIRA_ORIGINS, CP_UPSTREAM,
#   ADMIN_ALLOWED_IPS, ACME_EMAIL, TLS_MODE (acme|file, default acme)
{
	email {$ACME_EMAIL}
	order rate_limit before basic_auth
	# TLS_MODE=acme: per-app certificates, issued only for slugs the control plane
	# knows. TLS_MODE=file uses one wildcard certificate instead (tls-file.caddy).
	on_demand_tls {
		ask http://{$CP_UPSTREAM}/edge/tls-ask
	}
}

import /etc/caddy/common.caddy
import /etc/caddy/tls-{$TLS_MODE:acme}.caddy

{$STUDIO_HOST} {
	import studio
}

*.{$APPS_DOMAIN} {
	import apps_tls
	import apps
}
