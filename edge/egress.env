# Outbound throttling for the egress + inference proxy (sloptown-egress).
# Read once at startup. Later these become editable through
# PUT /admin/v1/egress-settings; this file then stays as the fallback default.
# Rates cap requests; weekly budgets cap tokens. Both apply.

# Hosts project containers may reach through the forward proxy (HTTP_PROXY,
# port EGRESS_PROXY_PORT). Comma-separated; "*.example.com" matches subdomains,
# an optional ":port" restricts the port. The inference proxy (/v1/*) and the
# platform API (/platform/*) are always allowed and are not listed here.
EGRESS_ALLOWLIST=

# Per-project request rate across all egress traffic (token bucket).
EGRESS_RPS_PER_PROJECT=10
EGRESS_BURST_PER_PROJECT=30

# Open requests/tunnels per project at once.
EGRESS_MAX_CONCURRENT_PER_PROJECT=8

# Inference calls per minute (sliding window).
INFERENCE_RPM_PER_PROJECT=60
INFERENCE_RPM_GLOBAL=600

# Largest request body accepted (bytes). 8 MiB allows a few screenshots.
EGRESS_MAX_BODY_BYTES=8388608

# Upstream connect/idle-read timeout (seconds). Streams may run longer as long
# as bytes keep flowing.
EGRESS_TIMEOUT_SECONDS=120

# Port of the raw CONNECT/forward proxy (0 disables it). The ASGI app is on 8200.
EGRESS_PROXY_PORT=8201
