# Pinned upstream versions for the Vibe images. Renovate bumps these (renovate.json).
# Each must be at least 14 days old when bumped (minimumReleaseAge).
PYTHON_IMAGE=docker.io/library/python:3.13-slim-bookworm
NODE_IMAGE=docker.io/library/node:22-bookworm-slim
UV_IMAGE=ghcr.io/astral-sh/uv:0.9.30
OPENCODE_VERSION=1.19.4
CADDY_BUILDER=docker.io/library/caddy:2.11-builder-alpine
CADDY_IMAGE=docker.io/library/caddy:2.11-alpine
RATELIMIT_VERSION=v0.1.0
CADDY_VERSION=v2.11.7
TRIVY_IMAGE=docker.io/aquasec/trivy:0.75.0
# Images run by quadlets as-is (auto-updated from upstream by `podman auto-update`).
POSTGRES_IMAGE=docker.io/library/postgres:17
REGISTRY_IMAGE=docker.io/library/registry:2
